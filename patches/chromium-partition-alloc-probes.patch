+void PartitionRoot::DumpAllStatsForTesting(PartitionStatsDumper* dumper) {
+  internal::ScopedGuard guard(GetEnumeratorLock());
+  internal::PartitionRootEnumerator::Instance().Enumerate(
+      +[](PartitionRoot* root, PartitionStatsDumper* output) {
+        char name[32];
+        snprintf(name, sizeof(name), "root-%p", static_cast<void*>(root));
+        root->DumpStats(name, false, true, output);
+      },
+      dumper, internal::PartitionRootEnumerator::EnumerateOrder::kNormal);
+}

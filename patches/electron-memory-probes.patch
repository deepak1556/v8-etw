+
+void RegisterMemoryETWProbe(gin_helper::Dictionary* exports) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("memory-etw-probe"))
+    return;
+  auto& observer = Observer();
+  base::AutoLock lock(observer.control_lock);
+  if (!observer.installed) {
+    const ULONG result = TraceLoggingRegister(g_memory_provider);
+    observer.registration_error = result;
+    if (result == ERROR_SUCCESS) {
+      observer.installed = true;
+    } else {
+      LOG(ERROR) << "Memory ETW provider registration failed: " << result;
+    }
+  }
+  exports->SetMethod<&StartProbe>("startMemoryProbe");
+  exports->SetMethod<&Checkpoint>("memoryCheckpoint");
+  exports->SetMethod<&WorkloadMarker>("memoryMarker");
+  exports->SetMethod<&StopProbe>("stopMemoryProbe");
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "memory-probe-test-fixture"))
+    exports->SetMethod<&SetRetentionFixture>("setMemoryRetentionFixture");
+}

+// Chromium's implementation exposes the ETW write status, unlike the SDK macro.
+TlmUInt64Field TraceLoggingUInt64(uint64_t value, const char* name) {
+  return TlmUInt64Field(name, value);
+}
+TlmUInt64Field TraceLoggingUInt32(uint32_t value, const char* name) {
+  return TlmUInt64Field(name, value);
+}
+TlmUInt64Field TraceLoggingBool(bool value, const char* name) {
+  return TlmUInt64Field(name, value);
+}
+TlmInt64Field TraceLoggingInt32(int32_t value, const char* name) {
+  return TlmInt64Field(name, value);
+}
+TlmUtf8StringField TraceLoggingString(const char* value, const char* name) {
+  return TlmUtf8StringField(name, value);
+}
+TlmUInt64Field TraceLoggingKeyword(uint64_t value) {
+  return TlmUInt64Field("EnabledKeyword", value);
+}
+class PointerField final : public TlmFieldWithConstants<1, 16> {
+ public:
+  PointerField(const char* name, const void* value)
+      : TlmFieldWithConstants(name),
+        value_(reinterpret_cast<uintptr_t>(value)) {}
+  void FillEventDescriptor(EVENT_DATA_DESCRIPTOR* output) const noexcept {
+    EventDataDescCreate(output, &value_, sizeof(value_));
+  }
+
+ private:
+  uintptr_t value_;
+};
+PointerField TraceLoggingPointer(const void* value, const char* name) {
+  return PointerField(name, value);
+}
+class BinaryField final : public TlmFieldWithConstants<2, 14> {
+ public:
+  BinaryField(const char* name, const void* value, uint16_t size)
+      : TlmFieldWithConstants(name), value_(value), size_(size) {}
+  void FillEventDescriptor(EVENT_DATA_DESCRIPTOR* output) const noexcept {
+    // TlmProvider allocates the field's declared descriptor count.
+    auto descriptors = UNSAFE_BUFFERS(base::span(output, GetDataDescCount()));
+    EventDataDescCreate(&descriptors[0], &size_, sizeof(size_));
+    EventDataDescCreate(&descriptors[1], value_, size_);
+  }
+
+ private:
+  const void* value_;
+  uint16_t size_;
+};
+BinaryField TraceLoggingBinary(const void* value,
+                               size_t size,
+                               const char* name) {
+  return BinaryField(name, value, static_cast<uint16_t>(size));
+}
+enum class ProviderTag { kMemory };
+constexpr auto g_memory_provider = ProviderTag::kMemory;
+template <typename... Fields>
+ULONG TraceLoggingWrite(ProviderTag,
+                        const char* name,
+                        const Fields&... fields) {
+  if (!Provider().IsEnabled(5, 1))
+    return ERROR_INVALID_STATE;
+  return Provider().WriteEvent(name, TlmEventDescriptor(5, 1), fields...);
+}
+bool TraceLoggingProviderEnabled(ProviderTag, uint8_t level, uint64_t keyword) {
+  return Provider().IsEnabled(level, keyword);
+}
+ULONG TraceLoggingRegister(ProviderTag) {
+  return Provider().Register("Electron.Memory", kMemoryGuid, {});
+}

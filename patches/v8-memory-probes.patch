+template <typename PoolEntry>
+size_t MemoryPool::PoolImpl<PoolEntry>::BackingSizeForTracing() const {
+  base::MutexGuard guard(&mutex_);
+  size_t bytes = 0;
+  for (const auto& [isolate, entries] : local_pools_) {
+    for (const auto& entry : entries) bytes += entry.size();
+  }
+  for (const auto& entry : shared_pool_) bytes += entry.size();
+  return bytes;
+}

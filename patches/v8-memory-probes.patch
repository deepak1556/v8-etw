+#ifndef V8_D8_D8_MEMORY_TRACE_H_
+#define V8_D8_D8_MEMORY_TRACE_H_
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
+#include "include/v8-isolate.h"
+
+namespace v8 {
+
+class ProcessMemorySampler {
+ public:
+  explicit ProcessMemorySampler(Isolate* isolate);
+  ~ProcessMemorySampler();
+  ProcessMemorySampler(const ProcessMemorySampler&) = delete;
+  ProcessMemorySampler& operator=(const ProcessMemorySampler&) = delete;
+
+  void Capture(const char* reason, GCType type = kGCTypeAll);
+
+ private:
+  static void Interrupt(Isolate* isolate, void*);
+  static void GCBefore(Isolate* isolate, GCType type, GCCallbackFlags, void*);
+  static void GCAfter(Isolate* isolate, GCType type, GCCallbackFlags, void*);
+  void Run();
+
+  Isolate* const isolate_;
+  uint64_t const scope_id_;
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  bool stopped_ = false;
+  std::atomic<bool> pending_{false};
+  std::atomic<uint64_t> requested_{0};
+  uint64_t delivered_ = 0;
+  std::thread thread_;
+};
+
+}  // namespace v8
+#endif  // V8_D8_D8_MEMORY_TRACE_H_

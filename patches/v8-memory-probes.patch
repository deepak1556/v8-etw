+    isolate->ThrowException(Exception::TypeError(
+        String::NewFromUtf8Literal(isolate, "Invalid Zone benchmark name")));
+    return;
+  }
+  auto* sampler = PerIsolateData::Get(isolate)->memory_sampler();
+  const bool begin = info[1]->BooleanValue(isolate);

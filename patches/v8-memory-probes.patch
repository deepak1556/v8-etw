index 0000000000000000000000000000000000000000..d26661f02b2da7f578a1d11c3a76db96fb68934c
--- /dev/null
+++ b/src/d8/d8-memory-trace.cc
@@ -0,0 +1,276 @@
+#include "src/d8/d8-memory-trace.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+
+#include "partition_alloc/partition_root.h"
+#include "partition_alloc/partition_stats.h"
+#include "src/d8/d8.h"
+#include "src/execution/isolate.h"
+#include "src/flags/flags.h"
+#include "src/heap/heap-allocator.h"
+#include "src/heap/heap-inl.h"
+#include "src/heap/heap.h"
+#include "src/heap/main-allocator.h"
+#include "src/heap/memory-allocator.h"
+#include "src/heap/memory-pool.h"
+#include "src/heap/read-only-spaces.h"
+#include "src/heap/spaces.h"
+#include "src/zone/accounting-allocator.h"
+#include "src/zone/zone-memory-trace.h"
+
+#if V8_ENABLE_WEBASSEMBLY
+#include "src/wasm/wasm-code-manager.h"
+#include "src/wasm/wasm-engine-globals.h"
+#include "src/wasm/wasm-engine.h"
+#endif
+
+#if defined(V8_OS_WIN)
+#include <windows.h>
+// Process-memory declarations require Windows SDK types.
+#include <psapi.h>
+#endif
+
+namespace v8 {
+namespace {
+std::atomic<uint64_t> next_scope{0};
+std::atomic<uint64_t> next_snapshot{0};
+std::atomic<uint64_t> active_scopes{0};
+
+class PartitionMemoryDumper final
+    : public partition_alloc::PartitionStatsDumper {
+ public:
+  PartitionMemoryDumper(Isolate* isolate, uint64_t snapshot)
+      : isolate_(isolate), snapshot_(snapshot) {}
+  void PartitionDumpTotals(
+      const char* name,
+      const partition_alloc::PartitionMemoryStats* stats) override {
+    char label[128];
+    const auto emit = [&](const char* metric, size_t first, size_t second,
+                          size_t third) {
+      const int length =
+          snprintf(label, sizeof(label), "partition/%s/%s", name, metric);
+      CHECK_GT(length, 0);
+      CHECK_LT(static_cast<size_t>(length), sizeof(label));
+      i::TraceZoneMemory(i::ZoneMemoryEvent::kMemorySnapshot, isolate_, nullptr,
+                         reinterpret_cast<const void*>(snapshot_), first,
+                         second, third, label);
+    };
+    emit("totals", stats->total_committed_bytes, stats->total_active_bytes,
+         stats->total_mmapped_bytes);
+    emit("allocated", stats->total_allocated_bytes, stats->total_active_count,
+         stats->total_resident_bytes);
+    emit("reclaimable", stats->total_decommittable_bytes,
+         stats->total_discardable_bytes, stats->total_resident_bytes);
+  }
+  void PartitionsDumpBucketStats(
+      const char*,
+      const partition_alloc::PartitionBucketMemoryStats*) override {}
+
+ private:
+  Isolate* const isolate_;
+  uint64_t const snapshot_;
+};
+
+size_t LabTail(i::MainAllocator* allocator) {
+  const auto& area = allocator->allocation_info();
+  const auto end =
+      std::max(area.limit(), allocator->extended_limit_for_tracing());
+  CHECK_GE(end, area.top());
+  return end - area.top();
+}
+}  // namespace
+
+ProcessMemorySampler::ProcessMemorySampler(Isolate* isolate)
+    : isolate_(isolate), scope_id_(++next_scope) {
+#if !defined(V8_OS_WIN)
+  FATAL("Process-memory ETW sampling requires Windows.");
+#endif
+  ++active_scopes;
+  isolate_->AddGCPrologueCallback(GCBefore);
+  isolate_->AddGCEpilogueCallback(GCAfter);
+  Capture("isolate-start");
+  thread_ = std::thread([this] { Run(); });
+}
+
+ProcessMemorySampler::~ProcessMemorySampler() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    stopped_ = true;
+  }
+  wake_.notify_one();
+  thread_.join();
+  isolate_->RemoveGCPrologueCallback(GCBefore);
+  isolate_->RemoveGCEpilogueCallback(GCAfter);
+  Capture("isolate-end");
+  --active_scopes;
+}
+
+void ProcessMemorySampler::Run() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  constexpr auto interval = std::chrono::milliseconds(20);
+  while (!wake_.wait_for(lock, interval, [this] { return stopped_; })) {
+    if (!pending_.exchange(true)) {
+      ++requested_;
+      // No borrowed sampler pointer escapes into a queued callback.
+      isolate_->RequestInterrupt(Interrupt, nullptr);
+    }
+  }
+}
+
+void ProcessMemorySampler::Interrupt(Isolate* isolate, void*) {
+  auto* data = PerIsolateData::Get(isolate);
+  if (!data || !data->memory_sampler()) return;
+  auto* sampler = data->memory_sampler();
+  ++sampler->delivered_;
+  sampler->Capture("periodic");
+  sampler->pending_ = false;
+}
+
+void ProcessMemorySampler::GCBefore(Isolate* isolate, GCType type,
+                                    GCCallbackFlags, void*) {
+  auto* data = PerIsolateData::Get(isolate);
+  if (data && data->memory_sampler()) {
+    data->memory_sampler()->Capture("gc-before", type);
+  }
+}
+
+void ProcessMemorySampler::GCAfter(Isolate* isolate, GCType type,
+                                   GCCallbackFlags, void*) {
+  auto* data = PerIsolateData::Get(isolate);
+  if (data && data->memory_sampler()) {
+    data->memory_sampler()->Capture("gc-after", type);
+  }
+}
+
+void ProcessMemorySampler::Capture(const char* reason, GCType type) {
+#if defined(V8_OS_WIN)
+  const uint64_t snapshot = ++next_snapshot;
+  const auto started = std::chrono::steady_clock::now();
+  const auto emit = [&](const char* name, uint64_t first, uint64_t second,
+                        uint64_t third) {
+    i::TraceZoneMemory(i::ZoneMemoryEvent::kMemorySnapshot, isolate_, nullptr,
+                       reinterpret_cast<const void*>(snapshot), first, second,
+                       third, name);
+  };
+  auto* isolate = reinterpret_cast<i::Isolate*>(isolate_);
+  auto* heap = isolate->heap();
+  auto* allocator = heap->allocator();
+  std::array<i::MainAllocator*, 4> labs = {
+      allocator->old_space_allocator(), allocator->code_space_allocator(),
+      allocator->trusted_space_allocator(),
+      heap->new_space() || i::v8_flags.sticky_mark_bits
+          ? allocator->new_space_allocator()
+          : nullptr};
+  std::array<std::pair<i::Address, i::Address>, 4> lab_bounds{};
+  for (size_t index = 0; index < labs.size(); ++index) {
+    if (labs[index]) {
+      const auto& area = labs[index]->allocation_info();
+      lab_bounds[index] = {area.top(), area.limit()};
+    }
+  }
+  char label[96];
+  snprintf(label, sizeof(label), "snapshot-begin/%s", reason);
+  emit(label, scope_id_, heap->gc_count().value(), static_cast<uint64_t>(type));
+  emit("sampling", requested_.load(), delivered_, active_scopes.load());
+
+  PROCESS_MEMORY_COUNTERS_EX process{};
+  process.cb = sizeof(process);
+  CHECK(GetProcessMemoryInfo(
+      GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&process),
+      sizeof(process)));
+  emit("process", process.PrivateUsage, process.WorkingSetSize,
+       process.PeakWorkingSetSize);
+
+  // Public heap statistics APIs retire LABs; these reads deliberately do not.
+  const size_t used = heap->SizeOfObjects();
+  const size_t physical = heap->CommittedPhysicalMemory();
+  const size_t committed = heap->CommittedMemory();
+  emit("heap", committed, used, physical);
+  emit("heap-external", heap->external_memory(), heap->backing_store_bytes(),
+       0);
+  emit("heap-aux", heap->CommittedMemoryExecutable(),
+       heap->TotalGlobalHandlesSize(), heap->UsedGlobalHandlesSize());
+  emit("contexts", heap->NumberOfNativeContexts(),
+       heap->NumberOfDetachedContexts(), 0);
+  emit("compiler-arena", isolate->allocator()->GetCurrentMemoryUsage(),
+       isolate->allocator()->GetMaxMemoryUsage(), 0);
+  auto* memory_pool = heap->memory_allocator()->memory_pool_for_tracing();
+  if (memory_pool) {
+    const auto pool = memory_pool->GetBackingStatsForTracing();
+    emit("v8-page-pool", pool.normal_bytes, pool.large_bytes, pool.zone_bytes);
+    emit("v8-page-pool-commit", pool.normal_committed_bytes,
+         pool.normal_bytes - pool.normal_committed_bytes, 0);
+  }
+  PartitionMemoryDumper partitions(isolate_, snapshot);
+  partition_alloc::PartitionRoot::DumpAllStatsForTesting(&partitions);
+
+  for (int id = i::FIRST_SPACE; id <= i::LAST_SPACE; ++id) {
+    if (id == i::RO_SPACE) continue;
+    auto* space = heap->space(id);
+    if (!space) continue;
+    const size_t space_used = space->SizeOfObjects();
+    const size_t space_physical = space->CommittedPhysicalMemory();
+    const size_t space_committed = space->CommittedMemory();
+    snprintf(label, sizeof(label), "space/%s",
+             i::ToString(static_cast<i::AllocationSpace>(id)));
+    emit(label, space_committed, space_used, space_physical);
+    snprintf(label, sizeof(label), "available/%s",
+             i::ToString(static_cast<i::AllocationSpace>(id)));
+    emit(label, space->Available(), 0, 0);
+  }
+  auto* ro = heap->read_only_space();
+  emit("shared-read-only", ro->CommittedMemory(), ro->Size(),
+       ro->CommittedPhysicalMemory());
+  emit("lab/old", LabTail(allocator->old_space_allocator()), 0, 0);
+  emit("lab/code", LabTail(allocator->code_space_allocator()), 0, 0);
+  emit("lab/trusted", LabTail(allocator->trusted_space_allocator()), 0, 0);
+  if (heap->new_space() || i::v8_flags.sticky_mark_bits) {
+    emit("lab/new", LabTail(allocator->new_space_allocator()), 0, 0);
+  }
+
+#if V8_ENABLE_WEBASSEMBLY
+  emit("wasm-process", i::wasm::GetWasmCodeManager()->committed_code_space(),
+       i::wasm::GetWasmEngine()->allocator()->GetCurrentMemoryUsage(), 0);
+#endif
+
+  std::array<HANDLE, 256> handles{};
+  const DWORD count =
+      GetProcessHeaps(static_cast<DWORD>(handles.size()), handles.data());
+  size_t allocated = 0, backing = 0, reserved = 0, failures = 0;
+  if (count == 0 || count > handles.size()) {
+    emit("windows-heap-error", GetLastError(), count, 0);
+    ++failures;
+  } else {
+    for (DWORD index = 0; index < count; ++index) {
+      HEAP_SUMMARY summary{};
+      summary.cb = sizeof(summary);
+      if (!HeapSummary(handles[index], 0, &summary)) {
+        emit("windows-heap-error", GetLastError(), index, 0);
+        ++failures;
+        continue;
+      }
+      allocated += summary.cbAllocated;
+      backing += summary.cbCommitted;
+      reserved += summary.cbReserved;
+    }
+  }
+  emit("windows-heaps", backing, allocated, reserved);
+  emit("windows-heap-coverage", count, failures, 0);
+  for (size_t index = 0; index < labs.size(); ++index) {
+    if (labs[index]) {
+      CHECK_EQ(lab_bounds[index].first, labs[index]->allocation_info().top());
+      CHECK_EQ(lab_bounds[index].second,
+               labs[index]->allocation_info().limit());
+    }
+  }
+  const uint64_t duration =
+      std::chrono::duration_cast<std::chrono::microseconds>(
+          std::chrono::steady_clock::now() - started)
+          .count();
+  emit("snapshot-end", duration, 0, 0);
+#endif
+}
+}  // namespace v8

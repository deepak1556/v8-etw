+  i::TraceZoneMemory(i::ZoneMemoryEvent::kBenchmark, isolate, nullptr, nullptr,
+                     0, info[1]->BooleanValue(isolate) ? 1 : 2, 0, *name);
+  if (sampler && begin) sampler->Capture("benchmark-begin");
+}

+    return;
+  }
+  static ZoneMemoryProvider* provider = new ZoneMemoryProvider;
+  if (!provider->handle || !EventProviderEnabled(provider->handle, 5, 1))
+    return;
+  std::lock_guard<std::mutex> guard(provider->mutex);
+  struct Record {
+    uint64_t version, sequence, kind, zone, allocator, segment;
+    uint64_t capacity, used, requested, managed, failed_writes, stack_depth;
+    uint64_t frames[24];
+  } record{};
+  record.version = 1;
+  record.sequence = ++provider->sequence;
+  record.kind = static_cast<uint64_t>(kind);
+  record.zone = reinterpret_cast<uintptr_t>(zone);
+  record.allocator = reinterpret_cast<uintptr_t>(allocator);
+  record.segment = reinterpret_cast<uintptr_t>(segment);
+  record.capacity = capacity;
+  record.used = used;
+  record.requested = requested;
+  record.managed =
+      allocator && static_cast<const AccountingAllocator*>(allocator)
+                       ->UsesManagedMemoryForTracing();
+  record.failed_writes = provider->failed_writes;
+  if (kind == ZoneMemoryEvent::kSegmentAdded) {
+    void* frames[24];
+    record.stack_depth = CaptureStackBackTrace(1, 24, frames, nullptr);
+    for (size_t i = 0; i < record.stack_depth; ++i)
+      record.frames[i] = reinterpret_cast<uintptr_t>(frames[i]);
+  }
+  const char* label = name ? name : "";
+  EVENT_DATA_DESCRIPTOR data[2];
+  EventDataDescCreate(&data[0], &record, sizeof(record));
+  EventDataDescCreate(&data[1], label, static_cast<ULONG>(strlen(label) + 1));
+  const EVENT_DESCRIPTOR descriptor{1, 0, 0, 5, 0, 0, 1};
+  const ULONG error = EventWrite(provider->handle, &descriptor, 2, data);
+  if (error != ERROR_SUCCESS) {
+    provider->failed_writes++;
+    PrintF("Zone ETW write failed: %lu\n", error);

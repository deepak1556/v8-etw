+class LifetimeInventory : private HeapVisitor<LifetimeInventory> {
+  friend class HeapVisitor<LifetimeInventory>;
+
+ public:
+  LifetimeInventory(HeapBase& heap, bool seed) : heap_(heap), seed_(seed) {}
+  void Run() { Traverse(heap_.raw_heap()); }
+
+ private:
+  bool VisitHeapObjectHeader(HeapObjectHeader& header) {
+    if (header.IsFree()) return true;
+    const auto bytes =
+        header.IsLargeObject()
+            ? LargePage::From(BasePage::FromPayload(header.ObjectStart()))
+                  ->PayloadSize()
+            : header.AllocatedSize();
+    if (seed_) {
+      heap_.NotifyLifetime(LifetimeEventKind::kSeedObject, header.ObjectStart(),
+                           nullptr, bytes, header.GetGCInfoIndex());
+    }
+    if (!header.IsInConstruction() && !types_seen_[header.GetGCInfoIndex()]) {
+      types_seen_[header.GetGCInfoIndex()] = true;
+      auto name = header.GetName(
+          HeapObjectNameForUnnamedObject::kUseClassNameIfSupported);
+      heap_.NotifyLifetime(LifetimeEventKind::kTypeName, nullptr, nullptr, 0,
+                           header.GetGCInfoIndex(), name.value);
+    }
+    return true;
+  }
+  HeapBase& heap_;
+  bool seed_;
+  std::array<bool, 1 << 14> types_seen_{};
+};

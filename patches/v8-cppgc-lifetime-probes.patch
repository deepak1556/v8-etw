+bool HeapBase::StartLifetimeObserverForTesting(LifetimeObserver observer,
+                                               void* context) {
+  CHECK(observer);
+  if (marker_) return false;
+  sweeper_.FinishIfRunning();
+  object_allocator_.ResetLinearAllocationBuffers();
+  {
+    v8::base::MutexGuard guard(g_lifetime_mutex.Pointer());
+    if (g_lifetime_observer.load()) return false;
+    g_lifetime_context = context;
+    g_lifetime_owner = this;
+    g_lifetime_sequence = 0;
+    g_lifetime_observer.store(observer, std::memory_order_release);
+  }
+  NotifyLifetime(LifetimeEventKind::kSeedBegin, nullptr, nullptr,
+                 sizeof(HeapObjectHeader));
+  EmitLifetimeInventoryForTesting(true);
+  NotifyLifetime(LifetimeEventKind::kSeedEnd);
+  return true;
+}
+
+void HeapBase::StopLifetimeObserverForTesting() {
+  sweeper_.FinishIfRunning();
+  v8::base::MutexGuard guard(g_lifetime_mutex.Pointer());
+  auto observer = g_lifetime_observer.load();
+  if (!observer) return;
+  CHECK_EQ(g_lifetime_owner, this);
+  const LifetimeEvent event{LifetimeEventKind::kCaptureEnd,
+                            this,
+                            ++g_lifetime_sequence,
+                            lifetime_gc_epoch_.load(),
+                            nullptr,
+                            nullptr,
+                            0,
+                            0,
+                            lifetime_major_gc_.load(),
+                            nullptr};
+  observer(g_lifetime_context, event);
+  g_lifetime_observer.store(nullptr, std::memory_order_release);
+  g_lifetime_owner = nullptr;
+  g_lifetime_context = nullptr;
+}
+
+void HeapBase::EmitLifetimeInventoryForTesting(bool seed) {
+  sweeper_.FinishIfRunning();
+  object_allocator_.ResetLinearAllocationBuffers();
+  LifetimeInventory(*this, seed).Run();
+}
+
+void HeapBase::NotifyLifetimeGcBegin(CollectionType type) {
+  lifetime_major_gc_.store(type == CollectionType::kMajor);
+  lifetime_gc_epoch_.fetch_add(1);
+  NotifyLifetime(LifetimeEventKind::kGcBegin);
+}
+
+void HeapBase::NotifyLifetimeGcEnd() {
+  NotifyLifetime(LifetimeEventKind::kGcEnd);
+}
 

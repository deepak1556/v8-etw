+
+void HeapBase::NotifyLifetime(LifetimeEventKind kind, const void* address,
+                              const void* other, size_t bytes, uint16_t gc_info,
+                              const char* type_name, size_t requested_bytes) {
+  if (!g_lifetime_observer.load(std::memory_order_acquire)) return;
+  v8::base::MutexGuard guard(g_lifetime_mutex.Pointer());
+  auto observer = g_lifetime_observer.load(std::memory_order_relaxed);
+  if (!observer) return;
+  const LifetimeEvent event{kind,
+                            this,
+                            ++g_lifetime_sequence,
+                            lifetime_gc_epoch_.load(),
+                            address,
+                            other,
+                            bytes,
+                            gc_info,
+                            lifetime_major_gc_.load(),
+                            type_name,
+                            requested_bytes};
+  observer(g_lifetime_context, event);
 }
 

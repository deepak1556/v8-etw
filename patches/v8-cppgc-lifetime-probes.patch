@@ -0,0 +1,45 @@
+#ifndef INCLUDE_CPPGC_INTERNAL_LIFETIME_OBSERVER_H_
+#define INCLUDE_CPPGC_INTERNAL_LIFETIME_OBSERVER_H_
+
+#include <cstddef>
+#include <cstdint>
+
+namespace cppgc::internal {
+
+enum class LifetimeEventKind : uint8_t {
+  kHeapCreated,
+  kSeedBegin,
+  kSeedObject,
+  kSeedEnd,
+  kAllocation,
+  kFree,
+  kMove,
+  kResize,
+  kGcBegin,
+  kGcEnd,
+  kTypeName,
+  kHeapDestroyed,
+  kCaptureEnd,
+};
+
+struct LifetimeEvent {
+  LifetimeEventKind kind;
+  const void* heap;
+  uint64_t sequence;
+  uint64_t gc_epoch;
+  const void* address;
+  const void* other_address;
+  size_t bytes;
+  uint16_t gc_info;
+  bool major_gc;
+  const char* type_name;
+  size_t requested_bytes = 0;
+};
+
+// The callback may run on a concurrent sweeping thread. It must not allocate
+// managed objects or dereference payload addresses.
+using LifetimeObserver = void (*)(void*, const LifetimeEvent&);
+
+}  // namespace cppgc::internal
+
+#endif  // INCLUDE_CPPGC_INTERNAL_LIFETIME_OBSERVER_H_

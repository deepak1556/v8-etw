      <Collectors>
        <SystemCollectorId Value="V8MemorySystem">
          <SystemProviderId Value="V8MemoryKernel"/>
        </SystemCollectorId>
        <EventCollectorId Value="V8MemoryEvents">
          <EventProviders>
            <EventProviderId Value="V8JIT"/>
            <EventProviderId Value="MemoryProbe"/>
            <EventProviderId Value="ZoneMemory"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
